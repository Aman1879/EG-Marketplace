# =============================================================================
# EG Marketplace - Backend Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS. NEVER COMMIT .env!
# =============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=3000

# MongoDB Database Connection
# IMPORTANT: Multi-document ACID transactions require a Replica Set deployment.
# Local development replica set: mongodb://localhost:27017/marketplace?replicaSet=rs0
# Production Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/marketplace?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/marketplace

# Dedicated Test Database Connection (used when running integration tests)
TEST_MONGODB_URI=mongodb://localhost:27017/marketplace_test

# Authentication & Session Security Keys
# CRITICAL: In production, generate strong 64-character random strings.
# Development fallback 'marketplace-secret-key-2025' is blocked in production.
JWT_SECRET=your_jwt_secret_minimum_32_characters_long
SESSION_SECRET=your_session_secret_minimum_32_characters_long

# CORS Allowed Origins
# Comma-separated list of approved browser origins allowed to interact with the API.
FRONTEND_URLS=http://localhost:5173,https://egmarketplace.netlify.app
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ALL=false

# Platform Business Configuration
ADMIN_COMMISSION_RATE=0.10

# Razorpay Payment Gateway Configuration
# Obtain from Razorpay Dashboard -> Settings -> API Keys & Webhooks.
# Test mode keys start with: rzp_test_...
# Live mode keys start with: rzp_live_...
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Initial Seed Admin Credentials (used by npm run db:seed)
ADMIN_EMAIL=admin@egmarketplace.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password

